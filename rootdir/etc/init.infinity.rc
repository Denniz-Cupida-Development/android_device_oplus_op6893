on property:ro.vendor.device=denniz
    setprop ro.infinity.camera "50MP + 8MP | 32 MP"
    setprop ro.infinity.display "1080 x 2400, 90 Hz"
    setprop ro.product.marketname "OnePlus Nord 2"


on property:ro.vendor.device=cupida
    setprop ro.infinity.camera "64MP + 8MP + 2MP | 16 MP"
    setprop ro.infinity.display "1080 x 2400, 120 Hz"
    setprop ro.product.marketname "Realme x7 MAX"

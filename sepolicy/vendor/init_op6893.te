type init_op6893, domain;
type init_op6893_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(init_op6893)
set_prop(init_op6893, vendor_device_prop)

allow init_op6893 odm_fw_file:dir rw_dir_perms;
allow init_op6893 odm_fw_file:file create_file_perms;
allow init_op6893 odm_fw_file:lnk_file { create_file_perms r_file_perms };
